 "auftraege": {
  "red_trio": {
   "titel": "The Red Trio",
   "von": "danzel",
   "ort": "macchia",
   "neben": true,
   "bis_tag": 15,
   "text": "Three people in red want back the steel plate you found in the rock niche above San Martinu. They attack on sight, and they are not very good at it.",
   "angenommen": "rt_gestartet",
   "fertig": "red_trio_fertig",
   "schritte": [
    {
     "text": "Get through the two women in red from the bushes.",
     "erledigt": {
      "flag": "rt_1_sieg"
     },
     "rueckblick": "You beat the first of them on the path above San Martinu, and they ran."
    },
    {
     "text": "Get through all three on the bridge.",
     "erledigt": {
      "flag": "rt_3_sieg"
     },
     "rueckblick": "You beat Danzel, Bibi and Charly on the bridge. Then men in black suits scattered them across the macchia."
    },
    {
     "text": "Find Danzel on the charcoal road.",
     "erledigt": {
      "flag": "rt_danzel_fertig"
     },
     "rueckblick": "You are finding Danzel, Bibi and Charly one by one, after the men in black suits scattered them."
    },
    {
     "text": "Find Bibi in the gorge.",
     "erledigt": {
      "flag": "rt_bibi_fertig"
     },
     "rueckblick": "You are finding Danzel, Bibi and Charly one by one, after the men in black suits scattered them."
    },
    {
     "text": "Find Charly on the ridge.",
     "erledigt": {
      "flag": "rt_charly_fertig"
     },
     "rueckblick": "You are finding Danzel, Bibi and Charly one by one, after the men in black suits scattered them."
    },
    {
     "text": "Get them all to Nonna Fiora's table at San Martinu.",
     "erledigt": {
      "flag": "rt_tisch_fertig"
     },
     "rueckblick": "Danzel, Bibi and Charly sat down at Nonna Fiora's long table at San Martinu."
    },
    {
     "text": "Hold Nonna Fiora's garden when Mr. White comes.",
     "wenn": {
      "flag": "rt_tisch_fertig"
     },
     "erledigt": {
      "flag": "red_trio_fertig"
     }
    }
   ],
   "grau": [
    {
     "text": "What you told Danzel",
     "wahl": {
      "rt_notiz_gesteht": "You told Danzel to tell Bibi himself.",
      "rt_notiz_kuendigung": "You told Danzel nobody has to know."
     }
    },
    {
     "text": "What you told Bibi about the lion",
     "wahl": {
      "rt_notiz_wahrheit": "You told Bibi what you did to her black lion, Mochi.",
      "rt_notiz_futter": "You said nothing and helped Bibi look for Mochi."
     }
    },
    {
     "text": "What you told Charly",
     "wahl": {
      "rt_notiz_mutter": "You told her to go home.",
      "rt_notiz_spiel": "You told her to show Danzel and Bibi the little game she made about them."
     }
    }
   ],
   "belohnung": "Incendio (jacket)",
   "romanze": false
  },
  "kloster": {
   "titel": "The Silence of San Martinu",
   "von": "casanova",
   "ort": "macchia",
   "text": "No herbs, no cheese, no letters from the monastery for three weeks. Madame Casanova thinks the animals in the harbour came from up there.",
   "angenommen": "kloster_angenommen",
   "fertig": "kloster_fertig",
   "schritte": [
    {
     "text": "Climb through the macchia to the monastery of San Martinu.",
     "erledigt": {
      "flag": "kl_tor_offen"
     },
     "rueckblick": "You reached the gate of San Martinu and met Nonna Fiora."
    },
    {
     "text": "Find the brothers and Frederico, the boy who ran after them.",
     "erledigt": {
      "eine": [
       {
        "flag": "kloster_frederico_lebt"
       },
       {
        "flag": "kloster_frederico_tot"
       }
      ]
     },
     "rueckblick": "You found out what happened to the brothers and to Frederico, the boy who ran after them."
    },
    {
     "text": "Report back to Madame Casanova at the harbour.",
     "erledigt": {
      "flag": "kloster_fertig"
     }
    }
   ],
   "grau": [
    {
     "text": "Trail or treasure at the fork",
     "wahl": {
      "kl_faehrte": "You followed the blood trail and the child's sandal.",
      "kl_schatz": "You climbed to the shining niche in the rock first."
     }
    },
    {
     "text": "The lion",
     "wahl": {
      "kl_loewe_erloest": "You ended his suffering.",
      "kl_loewe_frei": "You cut the chip out of his neck and let him go."
     }
    }
   ],
   "belohnung": "Le Large (boar spear)",
   "romanze": false
  },
  "berge": {
   "titel": "The Mountain and the Daughter",
   "von": "petru",
   "ort": "berge",
   "text": "Laetitia went up to the summer huts twelve days ago and didn't come back. In the village they say she was seen with a soldier. Petru, who never asks anyone for anything, asked you.",
   "angenommen": "berge_angenommen",
   "fertig": "berge_fertig",
   "schritte": [
    {
     "text": "Climb to the Genoese tower and get past the Legion.",
     "erledigt": {
      "flag": "bg_turm_erreicht"
     },
     "rueckblick": "You got past the Legion and its officer, Wolff, at the Genoese tower."
    },
    {
     "text": "Find Laetitia beyond the foggy ridge.",
     "erledigt": {
      "flag": "bg_bergerie_erreicht"
     },
     "rueckblick": "You found Petru's daughter Laetitia at the bergerie, with her soldier Adrien. Wolff wants him."
    },
    {
     "text": "Decide what happens to Adrien, Laetitia's soldier.",
     "erledigt": {
      "eine": [
       {
        "flag": "bg_weg_a"
       },
       {
        "flag": "bg_weg_b"
       },
       {
        "flag": "bg_weg_c"
       },
       {
        "flag": "bg_wolff_niederlage"
       }
      ]
     },
     "rueckblick": "It is settled what happens to Adrien. Petru is still waiting for news of his daughter."
    },
    {
     "text": "Tell Petru what happened to Laetitia, at his boathouse.",
     "erledigt": {
      "flag": "berge_fertig"
     }
    }
   ],
   "grau": [
    {
     "text": "Wolff's three questions",
     "wahl": {
      "bg_wolff_wahr_1": "You told Wolff about the soldier.",
      "bg_wolff_luege_1": "You told Wolff nothing."
     }
    },
    {
     "text": "Three ways down",
     "wahl": {
      "bg_weg_a": "You handed Adrien over to Wolff.",
      "bg_weg_b": "You got Adrien and Laetitia out by sea.",
      "bg_weg_c": "You showed Wolff Adrien's pictures."
     }
    }
   ],
   "belohnung": "Money and a képi, or a friend at the bergerie",
   "romanze": false
  },
  "old_grey": {
   "titel": "Old Grey",
   "von": "ghjuvan",
   "ort": "hochweide",
   "neben": true,
   "text": "Ghjuvan loses a sheep every night to a bear. There are no bears on Corsica. Ten more sheep and he has to sell five generations of pasture to the men in black.",
   "angenommen": "bg_u1_angenommen",
   "fertig": "bg_u1_fertig",
   "schritte": [
    {
     "text": "Follow the goat path to the bear.",
     "erledigt": {
      "flag": "bg_u1_fertig"
     }
    }
   ],
   "grau": [
    {
     "text": "The mother bear",
